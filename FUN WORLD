 if(action==='buy-shop'){if(stage23Data.shop.owned){showToast('もうお店を経営しているよ。');return;}if(fwCoins<180){showToast('開業には180コイン必要だよ。');return;}fwCoins-=180;stage23Data.shop.owned=true;stage23Data.shop.lastSaleAt=Date.now();if(mp.mode!=='guest'){stage23Shared.shopBuilt=true;stage23Shared.shopOwner=stage23SafeName(mp.displayName||'あなた');stage23BuildShopVisual();}else{showToast('個人ショップを開業したよ。共有ワールドの商店街の建設はホスト管理だよ。');}stage23SaveAndSync(mp.mode==='host');renderStage10HUD();return;}
