function updateMultiplayer(dt){updateSharedHomeVisibility();stage24Net.heartbeat+=dt;if(stage24Net.heartbeat>=4){stage24Net.heartbeat=0;if(mp.mode==='host'){for(const c of mp.connections.values()){try{if(c.open)c.send({type:'heartbeat',t:Date.now()});}catch(e){}}}else if(mp.mode==='guest'&&mp.hostConn){try{if(mp.hostConn.open)mp.hostConn.send({type:'heartbeat',t:Date.now()});}catch(e){}}}if(mp.mode==='guest'&&mp.hostConn&&mp.hostConn.open){mp.lastPoseSend+=dt;if(mp.lastPoseSend>.10){mp.lastPoseSend=0;try{mp.hostConn.send({type:'pose',pose:localPose()});}catch(e){}}}else if(mp.mode==='host'){for(const [id,u] of [...mp.users]){if(u.lastPoseAt&&performance.now()-u.lastPoseAt>9000){const c=mp.connections.get(id);try{c&&c.close();}catch(e){}mp.users.delete(id);removeRemote(id);}}mp.lastSnapshot+=dt;if(mp.lastSnapshot>.12){mp.lastSnapshot=0;broadcastSnapshot();}}for(const r of mp.remotes.values()){r.group.position.lerp(r.target,Math.min(1,dt*10));r.group.rotation.y+=(r.yaw-r.group.rotation.y)*Math.min(1,dt*10);if(r.petGroup){r.petGroup.visible=!['dive','kart','ferry','boat','train'].includes(r.mode);if(r.petGroup.visible){const tx=r.mode==='home'?r.group.position.x+Math.sin(r.yaw)*1.25:r.group.position.x+Math.sin(r.yaw)*1.35;const tz=r.mode==='home'?r.group.position.z+Math.cos(r.yaw)*1.25:r.group.position.z+Math.cos(r.yaw)*1.35;r.petGroup.position.x+=(tx-r.petGroup.position.x)*Math.min(1,dt*5);r.petGroup.position.z+=(tz-r.petGroup.position.z)*Math.min(1,dt*5);r.petGroup.position.y=.025+Math.abs(Math.sin(performance.now()*.004+r.yaw))*.035;r.petGroup.rotation.y=r.yaw;}}}}
