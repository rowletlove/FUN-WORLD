 if(action==='shop-price'){const price=Number(el.dataset.price);if([10,15,20,25].includes(price)){stage23Data.shop.price=price;stage23SaveAndSync(false);showToast(`販売価格を${price}コインに設定したよ。`);}return;}
 if(action==='shop-close'){showToast('休業ボタンは次回仕入れ時に再開できる簡易設定だよ。現在は自動販売を続けるよ。');return;}
