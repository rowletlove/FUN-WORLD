function stage28MoveWithCollision(x,z,dx,dz){
 let nx=x,nz=z,blocked=false,stopX=false,stopZ=false;
 const steps=Math.min(12,Math.max(1,Math.ceil(Math.max(Math.abs(dx),Math.abs(dz))/.22))),sx=dx/steps,sz=dz/steps;
 for(let i=0;i<steps;i++){
  if(!stopX){const tx=nx+sx;if(canWalkAt(tx,nz))nx=tx;else{stopX=true;blocked=true;}}
  if(!stopZ){const tz=nz+sz;if(canWalkAt(nx,tz))nz=tz;else{stopZ=true;blocked=true;}}
 }
 return {x:nx,z:nz,blocked};
}
