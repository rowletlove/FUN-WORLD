 // Distinct point colors and labels stop the leisure park, go-kart circuit, and horse racecourse from being mistaken for one another.
 for(const p of stage32GetDestinations()){
   const px=sx(p.x),py=sy(p.z);if(p.id===stage32NavTarget){ctx.beginPath();ctx.fillStyle='rgba(120,255,218,.26)';ctx.arc(px,py,11,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#a5ffe4';ctx.lineWidth=2;ctx.stroke();}
   ctx.beginPath();ctx.fillStyle=p.id==='leisure-park'?'#87f0b5':p.id==='kart-station'?'#ffd07a':p.id==='racecourse'?'#ff9e84':p.type==='sea'?'#76dcec':p.type==='island'?'#ffe19a':p.type==='sport'?'#ffc16c':'#e9f4ff';ctx.arc(px,py,p.id===stage32NavTarget?4.8:3.3,0,Math.PI*2);ctx.fill();
