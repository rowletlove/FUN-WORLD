 ctx.fillStyle='#285b58';ctx.strokeStyle='#86d0bb';ctx.lineWidth=2;ctx.beginPath();ctx.ellipse(sx(-315),sy(24),60/790*w,60/570*h,0,0,Math.PI*2);ctx.fill();ctx.stroke();
 ctx.fillStyle='#4b6659';ctx.beginPath();ctx.ellipse(sx(-315),sy(24),49/790*w,49/570*h,0,0,Math.PI*2);ctx.fill();
 ctx.fillStyle='#294b45';ctx.fillRect(sx(-102),sy(62),145/790*w,124/570*h);ctx.strokeStyle='#e5cc91';ctx.lineWidth=2;ctx.strokeRect(sx(-102),sy(62),145/790*w,124/570*h);
 ctx.fillStyle='#e0ece4';ctx.font='bold 10px system-ui';ctx.fillText('シーサイドタウン',sx(-92),sy(65)+13);ctx.fillText('フェリー島',sx(-350),sy(72));
 // Draw the actual kart circuit bounds from its sampled path; do not use the former huge rectangle that included other attractions.
 if(Array.isArray(kartTrackSamples)&&kartTrackSamples.length){
   const xs=kartTrackSamples.map(p=>p.x),zs=kartTrackSamples.map(p=>p.z),pad=12;
   const minX=Math.min(...xs)-pad,maxX=Math.max(...xs)+pad,minZ=Math.min(...zs)-pad,maxZ=Math.max(...zs)+pad;
   const left=sx(minX),right=sx(maxX),top=sy(maxZ),bottom=sy(minZ);
   ctx.fillStyle='rgba(207,143,68,.18)';ctx.strokeStyle='#e7bd79';ctx.lineWidth=1.8;ctx.setLineDash([6,4]);ctx.fillRect(left,top,right-left,bottom-top);ctx.strokeRect(left,top,right-left,bottom-top);ctx.setLineDash([]);
   ctx.fillStyle='#ffe0a7';ctx.font='bold 10px system-ui';ctx.fillText('GO-KART CIRCUIT',Math.max(8,Math.min(w-115,(left+right)/2-42)),Math.max(13,top+13));
 }
