 ctx.strokeStyle='rgba(155,216,234,.12)';ctx.lineWidth=1;for(let x=0;x<=w;x+=40){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,h);ctx.stroke();}for(let y=0;y<=h;y+=30){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke();}
 // Expanded map bounds include the whole leisure park, rather than clipping its entrance into the kart district.
