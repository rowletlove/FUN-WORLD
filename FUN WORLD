 ctx.beginPath();ctx.ellipse(sx(parkX),sy(parkZ),parkRX,parkRY,0,0,Math.PI*2);ctx.fillStyle='rgba(78,183,132,.20)';ctx.fill();ctx.strokeStyle='#86edb8';ctx.lineWidth=2.2;ctx.stroke();
